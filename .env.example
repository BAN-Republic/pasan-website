NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_WRITE_TOKEN=        # seed script only
SANITY_REVALIDATE_SECRET=      # any long random string (e.g. `openssl rand -hex 32`); paste the same value as the Secret of the Sanity webhook
# Contact form. While any of these three is empty (dev or production), the form runs in
# fallback mode: it opens the visitor's email app with the pitch addressed to the email
# in Site settings (and if that is empty too, only the social links are shown).
# Fill in all three and the form sends directly through Resend: no code change, just
# restart `npm run dev` or redeploy on Vercel.
RESEND_API_KEY=               # from resend.com → API Keys
CONTACT_TO_EMAIL=             # where pitches go (Pasan's inbox)
CONTACT_FROM_EMAIL=           # sender on a domain verified in Resend, e.g. "Website <pitch@yourdomain.com>"
NEXT_PUBLIC_SITE_URL=          # e.g. https://pasanrasantha.com (no trailing slash); used for canonical, og:url, sitemap and robots
